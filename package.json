{
  "name": "wardrobe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "tscheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "transform": "tsx scripts/transform.ts",
    "atlas": "tsx scripts/atlas.ts",
    "bake": "tsx scripts/blender.ts scripts/bake.py && yarn atlas",
    "bake:frame": "tsx scripts/blender.ts scripts/bake.py --frame && yarn atlas",
    "export:model": "tsx scripts/blender.ts scripts/export.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@react-three/handle": "^6.6.16",
    "@react-three/xr": "^6.6.16",
    "@tweenjs/tween.js": "^25.0.0",
    "classnames": "^2.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-image-gallery": "^1.4.0",
    "react-router": "^7.18.5",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-image-gallery": "^1.2.4",
    "@vitejs/plugin-react": "^6.2.1",
    "colors": "^1.4.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "packageManager": "yarn@1.22.22",
  "prettier": "./prettierrc.mjs"
}
